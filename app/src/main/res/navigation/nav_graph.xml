<?xml version="1.0" encoding="utf-8"?>
<!--
    El grafo solo contiene tres destinos. Las cinco pantallas de primer nivel (panel, reglas,
    logs, ajustes y acerca de) dejaron de ser destinos cuando pasaron a ser páginas del
    ViewPager2 de HomeFragment, que es lo que permite recorrerlas deslizando. Por eso las dos
    acciones de reglas cuelgan ahora de homeFragment: cuando ReglasFragment navega, el destino
    actual del NavController es el que aloja el pager, no la lista de reglas.
-->
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.capicua.smstotelegram.presentation.home.HomeFragment"
        android:label="@string/app_name">

        <action
            android:id="@+id/action_home_a_editar"
            app:destination="@id/editarReglaFragment" />

        <action
            android:id="@+id/action_home_a_probar"
            app:destination="@id/probarReglasFragment" />

    </fragment>

    <fragment
        android:id="@+id/editarReglaFragment"
        android:name="com.capicua.smstotelegram.presentation.rules.EditarReglaFragment"
        android:label="@string/nav_reglas">

        <!-- 0 significa «regla nueva»: ver EditarReglaViewModel.NUEVA -->
        <argument
            android:name="reglaId"
            app:argType="long"
            android:defaultValue="0L" />

    </fragment>

    <fragment
        android:id="@+id/probarReglasFragment"
        android:name="com.capicua.smstotelegram.presentation.rules.ProbarReglasFragment"
        android:label="@string/probar_title" />

</navigation>
