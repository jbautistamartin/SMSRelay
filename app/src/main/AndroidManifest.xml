<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        SMS: solo entrada. SEND_SMS se fue con el transporte por SMS, y READ_PHONE_STATE con
        el selector de SIM, que servía para elegir con cuál enviar. Esta aplicación recibe por
        la radio y entrega por otro medio, así que no necesita ni enviar ni saber qué tarjetas
        hay puestas. SEND_SMS además es un permiso restringido, y perderlo es una buena noticia.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Telefonía obligatoria: sin SIM no entra ningún SMS y la aplicación no hace nada -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <!-- Background work -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery optimization: permite solicitar exención para el foreground service -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        INTERNET es ahora el permiso central de la aplicación, y conviene leer esto antes de
        suponer nada: **el contenido de los SMS sale por aquí**. Se entrega a los servidores de
        Telegram, que es un tercero, mediante una petición al Bot API. Eso es lo que esta
        aplicación hace, no un efecto colateral, y «Acerca de» lo dice con todas las letras en
        el aviso de privacidad porque quien la instala tiene que saberlo.

        Hasta la versión anterior de este proyecto la frase era la contraria —el reenvío salía
        por la radio del operador y ningún mensaje tocaba la red— y la mantuvimos escrita aquí
        mientras fue verdad. Ya no lo es.

        El mismo permiso sirve al comprobador de versiones, que pregunta a api.github.com si hay
        publicada una versión más nueva y baja su APK cuando alguien lo pide. Eso sí se puede
        apagar desde «Acerca de»; la entrega de los mensajes, evidentemente, no.

        REQUEST_INSTALL_PACKAGES permite abrir el instalador del sistema con el APK descargado.
        No instala en silencio: Android enseña igualmente su diálogo, y desde Android 8 además
        hay que autorizar a esta aplicación en los ajustes.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />


    <application
        android:name=".SmsRelayApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsRelay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SMS Receiver: prioridad máxima. android:permission protege contra broadcasts falsos. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="2147483647">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Boot Receiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Arranque rápido de algunos fabricantes: lo mandan en lugar de
                     BOOT_COMPLETED cuando el apagado anterior fue el suyo. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Ingestion Foreground Service — not exported: solo se inicia desde SmsReceiver -->
        <service
            android:name=".service.SmsIngestionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Deshabilita la auto-inicialización de WorkManager (AndroidX Startup).
            Sin esto, WorkManager se inicializa con la fábrica por defecto ANTES de que
            Hilt inyecte HiltWorkerFactory, y los workers con @AssistedInject fallan con
            "Could not create Worker". Con esto, SmsRelayApplication (Configuration.Provider)
            provee la fábrica correcta la primera vez que se llama WorkManager.getInstance().
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- FileProvider para exportar logs a archivos compartibles -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
